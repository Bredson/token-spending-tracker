{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (Token Tracker)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension"],
      "outFiles": ["${workspaceFolder}/packages/vscode-extension/dist/**/*.js"],
      "preLaunchTask": "Build all packages",
      "sourceMaps": true
    }
  ]
}
